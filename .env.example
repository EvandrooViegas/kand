# Global Design Library admin sign-in (use a long, private random value).
GLOBAL_DESIGN_ADMIN_KEY=

# Primary provider for reference identity extraction; drafting uses available chat models.
GROQ_DESIGN_VISION_MODEL=qwen/qwen3.8-27b

# Automatic independent-provider fallback for design analysis and drafting.
OPENAI_API_KEY=
OPENAI_DESIGN_MODEL=gpt-4.1-mini

# Optional carousel image model override (otherwise uses existing image model).
OPENAI_CAROUSEL_IMAGE_MODEL=
# Internal admin debug output is already enabled in development.
CAROUSEL_INTERNAL_DEBUG=false
