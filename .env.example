# Global Design Library admin sign-in (use a long, private random value).
GLOBAL_DESIGN_ADMIN_KEY=

# Vision reconstruction only; normal post layout generation needs no vision call.
GROQ_DESIGN_VISION_MODEL=qwen/qwen3.8-27b
# Input tokens per minute your Groq plan allows for that model (on_demand qwen/qwen3.8-27b: 7000).
# Each reference image costs ~1,800 input tokens on that model, so on_demand fits two references per request.
# A 413 from Groq also teaches the real limit at runtime.
GROQ_DESIGN_VISION_INPUT_LIMIT=7000
